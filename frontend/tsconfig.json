// @human-maintained
{
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],

        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "bun",
            "node",
            "vite/client"
        ],

        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true
    },
    "include": [
        "index.ts",
        "vite.config.ts",
        "src/**/*.ts"
    ]
}